{
  // Cloudflare Workers static-assets config. The Astro build outputs to dist/,
  // which Workers serves directly. Connect the repo in the Cloudflare dashboard
  // with: root directory = web, build command = npm run build, deploy = npx wrangler deploy.
  "name": "wander-and-tales",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
