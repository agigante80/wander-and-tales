{
  // Cloudflare Workers config. The Astro build outputs to dist/, which Workers
  // serves as static assets. Connect the repo in the Cloudflare dashboard with:
  // root directory = web, build command = npm run build, deploy = npx wrangler deploy.
  //
  // worker/index.js runs first only for /api/* (the contact form); every other
  // path is served straight from the assets. The daily cron deletes contact
  // messages past their retention period. Secrets and the D1 setup are in
  // worker/README.md.
  "name": "wander-and-tales",
  "main": "worker/index.js",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["17 3 * * *"] }
}
