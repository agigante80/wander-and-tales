---
import { mediaUrl } from "../lib/content";
const { world, lang, locale } = Astro.props;
const cover = world.images?.find((i: any) => i.role === "cover") ?? world.images?.[0];
const img = mediaUrl(cover?.path);
const lore: string = world.lore?.[locale] ?? "";
const snippet = lore.length > 140 ? lore.slice(0, 137).trimEnd() + "..." : lore;
const TINTS = ["t-isles", "t-forest", "t-ember", "t-deep", "t-dusk"];
let h = 0;
for (const ch of world.id) h = (h + ch.charCodeAt(0)) % TINTS.length;
const tint = TINTS[h];
---

<a class="card card-link" href={`/${lang}/worlds/${world.id}`}>
  <div class={`art ${tint}`} style="aspect-ratio:2/3" role="img" aria-label={world.name[locale]}>
    {img ? <img src={img} alt="" loading="lazy" /> : <span class="label">{world.name[locale].toLowerCase()}</span>}
  </div>
  <div class="card-pad">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--sp-3)">
      <h3 style="font-size:var(--fs-h4)">{world.name[locale]}</h3>
      <span class="pill-count">{world.stories.length}</span>
    </div>
    {snippet && <p class="muted" style="font-size:var(--fs-small);margin-top:6px">{snippet}</p>}
  </div>
</a>
