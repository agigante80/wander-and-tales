---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found · Wander &amp; Tales</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#5b62a8" />
  </head>
  <body class="min-h-screen grid place-items-center text-center p-6 bg-paper text-ink">
    <div>
      <img src="/icon-rounded.svg" width="72" height="72" alt="" class="mx-auto rounded-2xl" />
      <h1 class="font-display text-3xl text-pine mt-5">This little world is not here</h1>
      <p class="mt-2 text-ink/70">The page you were looking for wandered off.</p>
      <a href="/en/" class="inline-block mt-6 bg-teal text-white font-display px-5 py-2.5 rounded-full hover:brightness-105">
        Back to Wander &amp; Tales
      </a>
    </div>
  </body>
</html>
