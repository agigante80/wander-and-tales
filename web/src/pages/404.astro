---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("wt-theme");
          if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) { document.documentElement.setAttribute("data-theme", "light"); }
      })();
    </script>
    <title>Not found · Wander &amp; Tales</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#5b62a8" />
  </head>
  <body style="display:grid;place-items:center;text-align:center;padding:var(--sp-6)">
    <div>
      <img src="/icon-rounded.svg" width="72" height="72" alt="" style="margin-inline:auto;border-radius:var(--r-lg)" />
      <h1 style="font-size:var(--fs-h2);color:var(--pine);margin-top:var(--sp-5)">This little world is not here</h1>
      <p class="muted" style="margin-top:var(--sp-2)">The page you were looking for wandered off.</p>
      <a class="btn btn-gold btn-lg" href="/en/" style="margin-top:var(--sp-6)">Back to Wander &amp; Tales</a>
    </div>
  </body>
</html>
