---
import Base from "../../../../layouts/Base.astro";
import { LANGS, SITE_URL, localeOf } from "../../../../consts";
import { worlds, site, mediaUrl, pdfUrl, pdfVer, narrationHtml, mdHtml, snippet, firstParagraph } from "../../../../lib/content";
import { t, AGE_RANGE } from "../../../../lib/i18n";

export function getStaticPaths() {
  return LANGS.flatMap((l) =>
    worlds.flatMap((w) =>
      w.stories.map((s: any) => ({ params: { lang: l.code, world: w.id, story: s.id } })),
    ),
  );
}
const { lang, world: worldId, story: storyId } = Astro.params;
const locale = localeOf(lang!);
const world = worlds.find((w) => w.id === worldId)!;
const story = world.stories.find((s: any) => s.id === storyId)!;

const cover = story.images?.find((i: any) => i.role === "cover");
const coverUrl = mediaUrl(cover?.path);
const worldCoverUrl = mediaUrl((world.images?.find((i: any) => i.role === "cover") ?? world.images?.[0])?.path);
const scenes = (story.images ?? []).filter((i: any) => i.role === "scene");

const cp = story.content_paths?.[locale] ?? {};
const simpleHtml = narrationHtml(cp.simple);
const richHtml = narrationHtml(cp.rich);
const rulesHtml = mdHtml(cp.rules);
const puzzlesHtml = mdHtml(cp.puzzles);
const labels = site.level_labels?.[locale] ?? { simple: "Simple", rich: "Full" };
const lead = snippet(firstParagraph(cp.simple));
const metaDesc = lead || site.tagline[locale];

const players = story.tags.players ?? {};
const playersText = players.max ? `${players.min} to ${players.max}` : `${players.min}+`;
const skills = (story.tags.skills ?? []).map((s: string) => s.replace(/-/g, " ")).join(" · ");

const sp = story.pdfs?.[locale] ?? {};
const ver = (e: any) => (pdfVer(e) ? ` · v${pdfVer(e)}` : "");

const docIco = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h8l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M13 3v5h5"/></svg>';

const jsonld = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: story.title[locale],
  inLanguage: locale,
  isAccessibleForFree: true,
  isPartOf: world.name[locale],
  url: `${SITE_URL}/${lang}/worlds/${world.id}/${story.id}`,
};
---

<Base
  lang={lang!}
  route={`worlds/${world.id}/${story.id}`}
  title={`${story.title[locale]} · ${world.name[locale]}`}
  description={metaDesc}
  image={coverUrl ?? undefined}
  jsonld={jsonld}
>
  <section class="wrap-read" style="padding-top:var(--sp-7)">
    <nav aria-label="Breadcrumb" style="font-size:var(--fs-small);color:var(--ink-faint);margin-bottom:var(--sp-4)">
      <a href={`/${lang}/`} style="color:var(--ink-faint)">Wander &amp; Tales</a>
      <span aria-hidden="true">  ›  </span>
      <a href={`/${lang}/worlds/${world.id}`} style="color:var(--ink-faint)">{world.name[locale]}</a>
    </nav>

    <p class="eyebrow">{t(lang!, "from_world")} {world.name[locale]}</p>
    <h1 style="font-size:var(--fs-display);margin-top:var(--sp-2)">{story.title[locale]}</h1>
    {lead && <p class="lead" style="margin-top:var(--sp-4)">{lead}</p>}

    <div class="chips" style="margin-top:var(--sp-5)">
      <span class="chip">{t(lang!, "ages")} {AGE_RANGE[story.tags.age_recommended] ?? story.tags.age_recommended}</span>
      <span class="chip">{playersText} {t(lang!, "players")}</span>
      <span class="chip">{story.tags.play_time_minutes} {t(lang!, "minutes")}</span>
      {skills && <span class="chip chip-teal">{skills}</span>}
    </div>

    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:var(--sp-3);margin-top:var(--sp-5)">
      <span class="badge-adult">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6Z"></path><path d="M9.5 12l1.8 1.8L15 10"></path></svg>
        {t(lang!, "adult_led")}
      </span>
    </div>
  </section>

  <section class="wrap-read reader" style="padding-top:var(--sp-7)" data-reader data-level="simple" id="reader">
    <div class="card" style="padding:var(--sp-4) var(--sp-5);display:flex;flex-wrap:wrap;align-items:center;gap:var(--sp-4);justify-content:space-between;position:sticky;top:calc(var(--header-h) + 8px);z-index:40">
      <div>
        <p class="kicker" style="margin-bottom:2px">{t(lang!, "reading_level")}</p>
        <p class="faint" style="font-size:var(--fs-tiny)">{t(lang!, "reader_note")}</p>
      </div>
      <div class="seg" data-level-seg role="group" aria-label={t(lang!, "reading_level")}>
        <button data-level="simple" aria-pressed="true">{labels.simple}<span class="ages">3 to 8</span></button>
        <button data-level="rich" aria-pressed="false">{labels.rich}<span class="ages">9 to 12</span></button>
      </div>
    </div>

    {coverUrl && (
      <figure style="margin:var(--sp-7) 0 0">
        <div class="art wide"><img src={coverUrl} alt={cover?.alt?.[locale] ?? ""} /></div>
      </figure>
    )}

    <article class="prose" style="margin-top:var(--sp-7)">
      {simpleHtml && <div data-when="simple" set:html={simpleHtml} />}
      {richHtml && <div data-when="rich" set:html={richHtml} />}
    </article>

    <div class="callout callout-promise" style="margin-top:var(--sp-7)">
      <p class="ph">{t(lang!, "the_promise")}</p>
      <p class="muted" style="font-size:var(--fs-small);margin-top:6px">{t(lang!, "online_note")}</p>
    </div>

    {(rulesHtml || puzzlesHtml) && (
      <details class="spoiler" style="margin-top:var(--sp-8)">
        <summary>
          <span class="lock"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2.5"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg></span>
          <span>
            <span class="sm-t">{t(lang!, "gm_title")}</span>
            <span class="sm-s">{t(lang!, "gm_hint")}</span>
          </span>
          <span class="chev"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"></path></svg></span>
        </summary>
        <div class="body">
          {rulesHtml && <div class="prose-tale" set:html={rulesHtml} />}
          {puzzlesHtml && <div class="prose-tale" set:html={puzzlesHtml} />}
        </div>
      </details>
    )}

    {scenes.length > 0 && (
      <section style="margin-top:var(--sp-9)">
        <p class="eyebrow">{t(lang!, "pictures")}</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-3);margin-top:var(--sp-4)">
          {scenes.map((im: any) => (
            mediaUrl(im.path) && (
              <figure style="margin:0">
                <div class="art square"><img src={mediaUrl(im.path)} alt={im.alt?.[locale] ?? ""} loading="lazy" /></div>
                <figcaption class="faint" style="font-size:var(--fs-tiny);margin-top:6px">{im.alt?.[locale] ?? ""}</figcaption>
              </figure>
            )
          ))}
        </div>
      </section>
    )}

    <section style="margin-top:var(--sp-9)">
      <h2 style="font-size:var(--fs-h3);margin:var(--sp-2) 0 var(--sp-3)">{t(lang!, "downloads")}</h2>
      <div style="display:grid;grid-template-columns:1fr;gap:var(--sp-3)">
        {pdfUrl(sp.tale_simple) && (
          <a class="btn-dl" href={pdfUrl(sp.tale_simple)} rel="noopener">
            <span class="ico" set:html={docIco} />
            <span><span class="t">{t(lang!, "tale_book")} · {labels.simple}</span><br /><span class="m">PDF{ver(sp.tale_simple)}</span></span>
            <span class="arr"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v13M6 11l6 6 6-6"></path></svg></span>
          </a>
        )}
        {pdfUrl(sp.tale_rich) && (
          <a class="btn-dl" href={pdfUrl(sp.tale_rich)} rel="noopener">
            <span class="ico" set:html={docIco} />
            <span><span class="t">{t(lang!, "tale_book")} · {labels.rich}</span><br /><span class="m">PDF{ver(sp.tale_rich)}</span></span>
            <span class="arr"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v13M6 11l6 6 6-6"></path></svg></span>
          </a>
        )}
        {pdfUrl(sp.atlas) && (
          <a class="btn-dl" href={pdfUrl(sp.atlas)} rel="noopener">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 4 4 6v14l5-2 6 2 5-2V4l-5 2-6-2Z"></path><path d="M9 4v14M15 6v14"></path></svg></span>
            <span><span class="t">{t(lang!, "atlas")}</span><br /><span class="m">PDF{ver(sp.atlas)}</span></span>
            <span class="arr"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v13M6 11l6 6 6-6"></path></svg></span>
          </a>
        )}
      </div>
    </section>

    <a class="card card-link" href={`/${lang}/worlds/${world.id}`} style="margin-top:var(--sp-8);padding:var(--sp-5);display:flex;align-items:center;gap:var(--sp-4)">
      <span class="art square" style="width:64px;height:64px;flex:none;border-radius:var(--r-md)" aria-hidden="true">{worldCoverUrl && <img src={worldCoverUrl} alt="" loading="lazy" />}</span>
      <span>
        <span class="faint" style="font-size:var(--fs-tiny);font-weight:700;text-transform:uppercase;letter-spacing:.08em">{t(lang!, "more_from_world")}</span>
        <span style="display:block;font-family:var(--font-display);font-weight:600;color:var(--ink-strong);font-size:var(--fs-h4)">{world.name[locale]} ›</span>
      </span>
    </a>
  </section>
</Base>
