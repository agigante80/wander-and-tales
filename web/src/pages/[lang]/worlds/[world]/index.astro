---
import Base from "../../../../layouts/Base.astro";
import { LANGS, SITE_URL, localeOf } from "../../../../consts";
import { worlds, site, mediaUrl, pdfUrl, pdfVer, snippet, firstParagraph } from "../../../../lib/content";
import { t, AGE_RANGE } from "../../../../lib/i18n";

export function getStaticPaths() {
  return LANGS.flatMap((l) => worlds.map((w) => ({ params: { lang: l.code, world: w.id } })));
}
const { lang, world: worldId } = Astro.params;
const locale = localeOf(lang!);
const world = worlds.find((w) => w.id === worldId)!;
const cover = world.images?.find((i: any) => i.role === "cover") ?? world.images?.[0];
const coverUrl = mediaUrl(cover?.path);
const wbE = world.pdfs?.[locale]?.world_book;
const ehE = world.pdfs?.[locale]?.example_heroes;
const guideE = site.shared_pdfs?.[locale]?.guide;
const htpE = site.shared_pdfs?.[locale]?.how_to_play;
const ver = (e: any) => (pdfVer(e) ? ` · v${pdfVer(e)}` : "");

const heroes = world.heroes ?? [];
const canon = world.canon ?? [];
const canonName = (id: string) => canon.find((c: any) => c.id === id)?.names?.[locale] ?? id;
const localize = (arr: any[]) => (arr ?? []).map((m: any) => (typeof m === "string" ? m : m?.[locale])).filter(Boolean);
const teaser = (s: any) => snippet(firstParagraph(s.content_paths?.[locale]?.simple));
const playersText = (s: any) => (s.tags.players?.max ? `${s.tags.players.min} to ${s.tags.players.max}` : `${s.tags.players?.min}+`);

const KIND_ORDER = ["quality", "character", "creature", "place", "item", "term"];
const KIND_KEY: Record<string, string> = { character: "c_character", creature: "c_creature", place: "c_place", item: "c_item", term: "c_term" };
const DOT: Record<string, string> = { quality: "var(--purple-2)", character: "var(--accent-solid)", creature: "var(--brand-green)", place: "var(--brand-dusk)", item: "var(--gold-solid)", term: "var(--gold-solid)" };
const groups = KIND_ORDER.map((k) => ({ kind: k, items: canon.filter((c: any) => c.kind === k) })).filter((g) => g.items.length);
const kindLabel = (k: string) =>
  k === "quality" ? t(lang!, world.hero_powers === "strength" ? "c_strength" : "c_magic") : t(lang!, KIND_KEY[k] ?? "c_term");

const dl = (e: any, title: string, ico: string) =>
  pdfUrl(e)
    ? `<a class="btn-dl" href="${pdfUrl(e)}" rel="noopener"><span class="ico">${ico}</span><span><span class="t">${title}</span><br><span class="m">PDF${ver(e)}</span></span><span class="arr"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v13M6 11l6 6 6-6"/></svg></span></a>`
    : "";
const icoBook = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h11l3 3v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="M8 9h7M8 13h7M8 17h4"/></svg>';
const icoHero = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3"/><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/></svg>';
const icoShield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6Z"/></svg>';

const jsonld = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: world.name[locale],
  inLanguage: locale,
  description: world.lore?.[locale],
  url: `${SITE_URL}/${lang}/worlds/${world.id}`,
};
---

<Base lang={lang!} route={`worlds/${world.id}`} title={`${world.name[locale]} · Wander & Tales`} description={snippet(world.lore?.[locale])} image={coverUrl ?? undefined} jsonld={jsonld}>
  <section class="world-hero">
    <div class="wrap inner">
      <div class="stack-4">
        <nav aria-label="Breadcrumb" style="font-size:var(--fs-small);color:rgba(246,241,230,.7)">
          <a href={`/${lang}/`} style="color:rgba(246,241,230,.7)">Wander &amp; Tales</a>
          <span aria-hidden="true">  ›  </span>
          <a href={`/${lang}/#worlds`} style="color:rgba(246,241,230,.7)">{t(lang!, "all_worlds")}</a>
        </nav>
        <h1>{world.name[locale]}</h1>
        <p>{world.lore?.[locale]}</p>
        <div class="chips" style="margin-top:var(--sp-2)">
          <span class="chip">{world.stories.length} {t(lang!, "stat_stories")}</span>
          <span class="chip">{t(lang!, "ages")} 3 to 12</span>
        </div>
      </div>
      <div class="art t-isles" style="aspect-ratio:2/3;max-width:300px;margin-inline:auto;box-shadow:0 24px 50px -22px rgba(0,0,0,.5)" role="img" aria-label={world.name[locale]}>
        {coverUrl && <img src={coverUrl} alt="" />}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <h2 style="font-size:var(--fs-h2);margin-bottom:var(--sp-6)">{t(lang!, "stories_in")}</h2>
    <div style="display:grid;grid-template-columns:1fr;gap:var(--sp-4)">
      {world.stories.map((s: any, i: number) => {
        const stale = teaser(s);
        const scov = mediaUrl((s.images?.find((im: any) => im.role === "cover") ?? s.images?.[0])?.path);
        return (
          <a class="card card-link" href={`/${lang}/worlds/${world.id}/${s.id}`} style="display:flex;gap:var(--sp-4);padding:var(--sp-4)">
            <span class="art" style="width:116px;flex:none;aspect-ratio:2/3;border-radius:var(--r-md)" role="img" aria-label={s.title[locale]}>
              {scov && <img src={scov} alt="" loading="lazy" />}
            </span>
            <div style="min-width:0">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                <h3 style="font-size:var(--fs-h3)">{s.title[locale]}</h3>
                {i === 0 && (
                  <span class="badge-adult"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6Z"></path></svg>{t(lang!, "adult_led")}</span>
                )}
              </div>
              {stale && <p class="muted" style="margin-top:6px;font-size:var(--fs-small)">{stale}</p>}
              <div class="chips" style="margin-top:var(--sp-3)">
                <span class="chip">{t(lang!, "ages")} {AGE_RANGE[s.tags.age_recommended] ?? s.tags.age_recommended}</span>
                <span class="chip">{s.tags.play_time_minutes} {t(lang!, "minutes")}</span>
                {(s.tags.skills ?? []).slice(0, 2).map((sk: string) => <span class="chip chip-teal">{sk.replace(/-/g, " ")}</span>)}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  {heroes.length > 0 && (
    <section class="section wrap" style="padding-top:0">
      <h2 style="font-size:var(--fs-h2);margin-bottom:var(--sp-2)">{t(lang!, "heroes_title")}</h2>
      <div class="hero-cards" style="margin-top:var(--sp-6)">
        {heroes.map((h: any) => (
          <div class="card hero-card card-pad stack-4">
            <div style="display:flex;align-items:center;gap:var(--sp-4)">
              <span class="art square t-isles" style="width:72px;height:72px;flex:none;border-radius:var(--r-md)" aria-hidden="true">
                {mediaUrl(h.image_path) && <img src={mediaUrl(h.image_path)} alt="" loading="lazy" />}
              </span>
              <div>
                <h3 style="font-size:var(--fs-h4)">{h.name}</h3>
                <p class="faint" style="font-size:var(--fs-small)">{AGE_RANGE[h.tier] ?? h.tier}</p>
              </div>
            </div>
            {h.magics?.length > 0 && (
              <div>
                <p class="kicker" style="margin-bottom:8px">{t(lang!, world.hero_powers === "strength" ? "c_strength" : "c_magic")}</p>
                <div class="chips">{h.magics.map((m: string) => <span class="chip chip-teal">{canonName(m)}</span>)}</div>
              </div>
            )}
            {typeof h.energy === "number" && (
              <div>
                <div style="display:flex;justify-content:space-between;font-size:var(--fs-small);margin-bottom:6px"><span class="muted">{t(lang!, "energy")}</span></div>
                <div class="meter"><i style={`width:${Math.round((h.energy / 5) * 100)}%`}></i></div>
              </div>
            )}
            {h.carry?.length > 0 && (
              <div>
                <p class="kicker" style="margin-bottom:8px">{t(lang!, "carries")}</p>
                <div class="carry">{localize(h.carry).map((c: string) => <span>{c}</span>)}</div>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {groups.length > 0 && (
    <section class="section wrap" style="padding-top:0">
      <h2 style="font-size:var(--fs-h2);margin-bottom:var(--sp-6)">{t(lang!, "whoswho_title")}</h2>
      <div class="glossary">
        {groups.map((g) => (
          <div class="card card-pad gloss-group">
            <h3><span class="dot" style={`background:${DOT[g.kind]}`}></span>{kindLabel(g.kind)}</h3>
            <dl>
              {g.items.map((c: any) => (
                <div><dt>{c.names?.[locale] ?? c.id}</dt><dd>{c.description?.[locale] ?? ""}</dd></div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="section wrap" style="padding-top:0">
    <h2 style="font-size:var(--fs-h2);margin-bottom:var(--sp-5)">{t(lang!, "world_downloads")}</h2>
    <div style="display:grid;grid-template-columns:1fr;gap:var(--sp-3)"
      set:html={[
        dl(wbE, t(lang!, "world_book"), icoBook),
        dl(ehE, t(lang!, "example_heroes"), icoHero),
        dl(guideE, t(lang!, "guide"), icoShield),
        dl(htpE, t(lang!, "how_to_play"), icoBook),
      ].join("")}
    />
  </section>
</Base>
