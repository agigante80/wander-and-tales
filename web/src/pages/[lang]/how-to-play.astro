---
import Base from "../../layouts/Base.astro";
import { LANGS, localeOf } from "../../consts";
import { site, pdfUrl, pdfVer } from "../../lib/content";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const locale = localeOf(lang!);
const htp = site.shared_pdfs?.[locale]?.how_to_play;
const ver = (e: any) => (pdfVer(e) ? ` · v${pdfVer(e)}` : "");

const steps = [
  { body: t(lang!, "htp_s1"), ic: '<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16M4 12h16M4 19h10"/></svg>' },
  { body: t(lang!, "htp_s2"), ic: '<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h7v14H6a2 2 0 0 1-2-2Z"/><path d="M20 5h-7v14h5a2 2 0 0 0 2-2Z"/></svg>' },
  { body: t(lang!, "htp_s3"), ic: '<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.3" fill="currentColor"/><circle cx="15.5" cy="8.5" r="1.3" fill="currentColor"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/><circle cx="8.5" cy="15.5" r="1.3" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.3" fill="currentColor"/></svg>' },
];
---

<Base lang={lang!} route="how-to-play" title={`${t(lang!, "how_to_play")} · Wander & Tales`} description={t(lang!, "meta_help")}>
  <section class="wrap-read htp-hero">
    <p class="eyebrow rise">{t(lang!, "hero_kicker")}</p>
    <h1 class="rise d1" style="font-size:var(--fs-display);margin-top:var(--sp-2)">{t(lang!, "how_to_play")}</h1>
    <p class="lead rise d2" style="margin:var(--sp-4) auto 0;max-width:50ch">{t(lang!, "hero_sub")}</p>
  </section>

  <section class="section wrap" style="padding-top:var(--sp-6)">
    <div class="three">
      {steps.map((s, i) => (
        <div class="card">
          <span class="num">{i + 1}</span>
          <p class="muted">{s.body}</p>
          <Fragment set:html={s.ic} />
        </div>
      ))}
    </div>
  </section>

  <section class="wrap-read">
    <div class="callout callout-promise center" style="padding:var(--sp-8) var(--sp-6)">
      <p class="ph" style="font-size:clamp(1.5rem,1.1rem + 2vw,2.2rem)">{t(lang!, "the_promise")}</p>
      <p class="muted" style="margin-top:var(--sp-3);max-width:46ch;margin-inline:auto">{t(lang!, "online_note")}</p>
    </div>
  </section>

  <section class="wrap-read section">
    <div style="display:grid;grid-template-columns:1fr;gap:var(--sp-4)">
      {pdfUrl(htp) && (
        <a class="btn-dl" href={pdfUrl(htp)} rel="noopener">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h8l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"></path><path d="M13 3v5h5"></path></svg></span>
          <span><span class="t">{t(lang!, "how_to_play")}</span><br /><span class="m">PDF{ver(htp)}</span></span>
          <span class="arr"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v13M6 11l6 6 6-6"></path></svg></span>
        </a>
      )}

      <a class="card card-link" href={`/${lang}/help`} style="padding:var(--sp-5);display:flex;align-items:center;gap:var(--sp-4)">
        <span class="art square t-deep" style="width:64px;height:64px;flex:none;border-radius:var(--r-md)" aria-hidden="true"></span>
        <span>
          <span class="kicker">{t(lang!, "htp_more")}</span>
          <span style="display:block;font-family:var(--font-display);font-weight:600;color:var(--ink-strong);font-size:var(--fs-h4);margin-top:2px">{t(lang!, "guide")} ›</span>
        </span>
      </a>
    </div>

    <p class="center" style="margin-top:var(--sp-8)">
      <a class="btn btn-primary btn-lg" href={`/${lang}/#worlds`}>{t(lang!, "hero_read")}</a>
    </p>
  </section>
</Base>
