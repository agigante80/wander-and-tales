---
import Legal from "../../layouts/Legal.astro";
import { LANGS } from "../../consts";
import { t } from "../../lib/i18n";
import { marked } from "marked";

// localized content lives in web/src/content/why/<lang>.md
const files = import.meta.glob("../../content/why/*.md", {
  query: "?raw",
  import: "default",
  eager: true,
});

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const md = (files[`../../content/why/${lang}.md`] ?? files["../../content/why/en.md"]) as string;
const html = marked.parse(md, { gfm: true, async: false }) as string;
const banner = "/media/worlds/enchanted-springs/stories/mouras-lost-comb/assets/scene-the-spring-sings-again.png";
---

<Legal lang={lang!} route="why" heading={t(lang!, "nav_why")} description={t(lang!, "meta_why")} image={banner}>
  <img src={banner} alt="" loading="lazy" class="w-full rounded-2xl border border-paper mt-2 mb-7" />
  <div set:html={html} />
</Legal>
