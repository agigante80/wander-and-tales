---
import Legal from "../../layouts/Legal.astro";
import { LANGS, REPO } from "../../consts";
import { t } from "../../lib/i18n";
export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
---

<Legal lang={lang!} route="terms" heading={t(lang!, "terms")} description={t(lang!, "meta_terms")}>
  <p class="text-sm text-ink/50">This notice is currently provided in English; localized versions will follow.</p>

  <h2>Free to use</h2>
  <p>Everything here is free to read, print, and play. The games are cooperative and no-lose: nobody competes, nobody is eliminated, and there are no wrong answers. They are meant to be played by children together with a grown-up.</p>

  <h2>Licence</h2>
  <p>The stories and art are licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener">CC BY-SA 4.0</a>: you may share and adapt them, even commercially, with credit to Wander &amp; Tales, keeping derivatives under the same licence. The code is licensed under MIT. See the repository for details.</p>

  <h2>As is</h2>
  <p>The site and its files are provided "as is", without warranties of any kind. Use your own judgement about what suits your family. Adult supervision is recommended.</p>

  <h2>Illustrations and external links</h2>
  <p>Illustrations are AI-generated. Links to external sites (such as GitHub) are provided for convenience; we are not responsible for their content. We may add, change, or remove material at any time.</p>

  <h2>Independence and contact</h2>
  <p>Wander &amp; Tales is not affiliated with Anthropic. For takedown or other requests, write to <a href="mailto:privacy@wanderandtales.com">privacy@wanderandtales.com</a> or open an issue at <a href={REPO + "/issues"} rel="noopener">the project on GitHub</a>.</p>
</Legal>
