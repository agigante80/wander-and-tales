---
import Base from "../../layouts/Base.astro";
import WorldCard from "../../components/WorldCard.astro";
import { LANGS, SITE_URL, localeOf } from "../../consts";
import { worlds, site } from "../../lib/content";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const locale = localeOf(lang!);
const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Wander & Tales",
  url: SITE_URL,
  inLanguage: locale,
  description: site.tagline[locale],
};
---

<Base lang={lang!} route="" title={`Wander & Tales · ${site.tagline[locale]}`} jsonld={jsonld}>
  <section class="bg-gradient-to-b from-dusk to-dusk2 text-cream">
    <div class="max-w-5xl mx-auto px-4 py-16 md:py-24 text-center">
      <p class="uppercase tracking-wide text-cream/80 text-sm">{t(lang!, "hero_kicker")}</p>
      <h1 class="font-display text-4xl md:text-6xl mt-3">Wander <span class="text-gold">&amp;</span> Tales</h1>
      <p class="max-w-2xl mx-auto mt-5 text-cream/90 text-lg">{t(lang!, "hero_sub")}</p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href={`/${lang}/how-to-play`} class="bg-gold text-ink font-display px-5 py-2.5 rounded-full hover:brightness-105">{t(lang!, "how_to_play")}</a>
        <a href="#worlds" class="bg-cream/15 ring-1 ring-cream/40 px-5 py-2.5 rounded-full hover:bg-cream/25">{t(lang!, "hero_read")}</a>
      </div>
    </div>
  </section>

  <section id="worlds" class="max-w-5xl mx-auto px-4 py-14">
    <h2 class="font-display text-2xl md:text-3xl text-pine">{t(lang!, "worlds_title")}</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-6">
      {worlds.map((w) => <WorldCard world={w} lang={lang} locale={locale} />)}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="rounded-2xl bg-white border border-paper p-8 text-center">
      <h2 class="font-display text-2xl text-purple">{t(lang!, "create_title")}</h2>
      <p class="max-w-2xl mx-auto mt-3 text-ink/75">{t(lang!, "create_body")}</p>
      <a href={`/${lang}/create`} class="inline-block mt-5 bg-purple text-white font-display px-5 py-2.5 rounded-full hover:brightness-110">{t(lang!, "create_cta")}</a>
    </div>
  </section>
</Base>
