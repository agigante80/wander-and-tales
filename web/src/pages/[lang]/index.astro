---
import Base from "../../layouts/Base.astro";
import WorldCard from "../../components/WorldCard.astro";
import { LANGS, SITE_URL, localeOf } from "../../consts";
import { worlds, site, mediaUrl } from "../../lib/content";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const locale = localeOf(lang!);
const storyCovers = worlds
  .flatMap((w: any) => w.stories.map((s: any) => mediaUrl((s.images?.find((i: any) => i.role === "cover") ?? s.images?.[0])?.path)))
  .filter(Boolean);
const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Wander & Tales",
  url: SITE_URL,
  inLanguage: locale,
  description: site.tagline[locale],
};
---

<Base lang={lang!} route="" title={`Wander & Tales · ${site.tagline[locale]}`} jsonld={jsonld}>
  <section class="hero">
    <div class="wrap inner">
      <div class="stack-4">
        <p class="eyebrow rise">{t(lang!, "hero_kicker")}</p>
        <h1 class="rise d1">Wander <span class="amp">&amp;</span> Tales</h1>
        <p class="sub rise d2">{t(lang!, "hero_sub")}</p>
        <div class="acts rise d3">
          <a class="btn btn-gold btn-lg" href={`/${lang}/how-to-play`}>{t(lang!, "how_to_play")}</a>
          <a class="btn btn-secondary btn-lg" href="#worlds">{t(lang!, "hero_read")}</a>
        </div>
        <div class="pills rise d4">
          <span class="stat"><b>7</b><span>{t(lang!, "stat_worlds")}</span></span>
          <span class="statsep" aria-hidden="true"></span>
          <span class="stat"><b>21</b><span>{t(lang!, "stat_stories")}</span></span>
          <span class="statsep" aria-hidden="true"></span>
          <span class="stat"><b>4</b><span>{t(lang!, "stat_languages")}</span></span>
        </div>
      </div>
      <div class="scene rise d2" role="img" aria-label="A little green house on a floating island beneath a crescent moon">
        <svg viewBox="0 0 512 512" aria-hidden="true"><circle cx="372" cy="118" r="42" fill="#f6f1e6"></circle><circle cx="390" cy="106" r="36" fill="#6a6cae"></circle><circle cx="138" cy="150" r="22" fill="#f2a93b"></circle><circle cx="300" cy="70" r="15" fill="#f2a93b"></circle><path d="M196,256 C182,296 204,344 256,392 C308,344 330,296 316,256 Z" fill="#25543c"></path><ellipse cx="256" cy="256" rx="76" ry="27" fill="#2f6f4f"></ellipse><polygon points="224,212 256,178 288,212" fill="#25543c"></polygon><rect x="230" y="210" width="52" height="44" rx="3" fill="#f6f1e6"></rect><rect x="247" y="225" width="18" height="29" rx="2" fill="#f2a93b"></rect><path d="M104,330 C96,356 110,388 144,418 C178,388 192,356 184,330 Z" fill="#2f6f4f"></path><ellipse cx="144" cy="330" rx="46" ry="17" fill="#4ea24a"></ellipse><path d="M330,348 C324,368 334,392 360,414 C386,392 396,368 390,348 Z" fill="#25543c"></path><ellipse cx="360" cy="348" rx="36" ry="13" fill="#4ea24a"></ellipse></svg>
      </div>
    </div>
  </section>

  <section class="section wrap" id="worlds">
    <h2 style="font-size:var(--fs-h2)">{t(lang!, "worlds_title")}</h2>
    <div class="grid-worlds" style="margin-top:var(--sp-6)">
      {worlds.map((w) => <WorldCard world={w} lang={lang} locale={locale} />)}
    </div>
  </section>

  <section class="section wrap" id="create">
    <div class="create">
      <div class="stack-4">
        <p class="kicker">{t(lang!, "nav_create")}</p>
        <h2 style="font-size:var(--fs-h2)">{t(lang!, "create_title")}</h2>
        <p class="muted">{t(lang!, "create_body")}</p>
        <div class="acts" style="margin-top:var(--sp-2)">
          <a class="btn btn-primary" href={`/${lang}/create`}>{t(lang!, "create_cta")}</a>
        </div>
      </div>
      <div class="art tall t-dusk" role="img" aria-label={t(lang!, "create_title")} data-cover-carousel data-srcs={JSON.stringify(storyCovers)}>
        <img class="art-cf show" src={storyCovers[0]} alt="" decoding="async" />
        <img class="art-cf" alt="" decoding="async" />
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var box = document.querySelector("[data-cover-carousel]");
      if (!box) return;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return; // keep the single static image
      var srcs;
      try { srcs = JSON.parse(box.getAttribute("data-srcs") || "[]"); } catch (e) { return; }
      if (srcs.length < 2) return;
      for (var i = srcs.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = srcs[i]; srcs[i] = srcs[j]; srcs[j] = t; }
      var layers = box.querySelectorAll(".art-cf");
      if (layers.length < 2) return;
      var idx = 0, front = 0, timer = null;
      function next() {
        idx = (idx + 1) % srcs.length;
        var back = 1 - front;
        var img = layers[back];
        img.onload = function () {
          layers[back].classList.add("show");
          layers[front].classList.remove("show");
          front = back;
        };
        img.src = srcs[idx];
      }
      function start() { if (!timer) timer = setInterval(next, 5200); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      start();
      box.addEventListener("mouseenter", stop);
      box.addEventListener("mouseleave", start);
      box.addEventListener("focusin", stop);
      box.addEventListener("focusout", start);
    })();
  </script>
</Base>
