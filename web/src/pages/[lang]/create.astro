---
import Base from "../../layouts/Base.astro";
import { LANGS, CREATE_URL, REPO, localeOf } from "../../consts";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const steps = [
  ["Clone the repository.", "git clone https://github.com/agigante80/wander-and-tales.git"],
  ["Set up the toolchain (Python 3.11+).", 'pip install -e ".[dev,render]"'],
  ['In Claude Code, ask to "create a story".', "The create-story skill walks you through it."],
  ["Pictures, your choice.", "Generate with your own key, paste prompts elsewhere, or play text-only."],
  ["Read and play.", "Your printable PDFs build into dist/, in four languages."],
];
---

<Base lang={lang!} route="create" title={`${t(lang!, "create_title")} · Wander & Tales`} description={t(lang!, "create_body")}>
  <section class="wrap-read section">
    <p class="kicker">{t(lang!, "nav_create")}</p>
    <h1 style="font-size:var(--fs-h2);margin-top:var(--sp-2)">{t(lang!, "create_title")}</h1>
    <p class="lead" style="margin-top:var(--sp-4)">{t(lang!, "create_body")}</p>

    <ol class="steps" style="margin-top:var(--sp-7)">
      {steps.map(([title, detail]) => (
        <li>
          <div>
            <p class="font-display">{title}</p>
            <p class="muted" style="font-family:ui-monospace,monospace;font-size:var(--fs-small);margin-top:2px;word-break:break-word">{detail}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="acts" style="display:flex;flex-wrap:wrap;gap:var(--sp-3);margin-top:var(--sp-8)">
      <a class="btn btn-primary" href={CREATE_URL} rel="noopener">{t(lang!, "create_cta")}</a>
      <a class="btn btn-secondary" href={REPO} rel="noopener">{t(lang!, "source")}</a>
    </div>
    <p class="faint" style="font-size:var(--fs-tiny);margin-top:var(--sp-5)">{t(lang!, "not_affiliated")}</p>
  </section>
</Base>
