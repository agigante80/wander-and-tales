---
import Base from "../../layouts/Base.astro";
import { LANGS, localeOf } from "../../consts";
import { site, pdfUrl, pdfVer, narrationHtml } from "../../lib/content";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const locale = localeOf(lang!);
const html = narrationHtml(`guide/${locale}/guide.md`); // strips the guide's own H1
const htp = site.shared_pdfs?.[locale]?.how_to_play;
const guide = site.shared_pdfs?.[locale]?.guide;
const ver = (e: any) => (pdfVer(e) ? ` · v${pdfVer(e)}` : "");
const docIco = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h8l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M13 3v5h5"/></svg>';
const arr = '<span class="arr"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v13M6 11l6 6 6-6"/></svg></span>';
---

<Base lang={lang!} route="help" title={`${t(lang!, "guide")} · Wander & Tales`} description={t(lang!, "meta_guide")}>
  <section class="wrap-read" style="padding-top:var(--sp-9)">
    <h1 style="font-size:var(--fs-h2);color:var(--pine)">{t(lang!, "guide")}</h1>
    <p class="lead" style="margin-top:var(--sp-3)">{t(lang!, "hero_sub")}</p>
    <div style="display:grid;grid-template-columns:1fr;gap:var(--sp-3);margin-top:var(--sp-5)"
      set:html={[
        pdfUrl(guide) ? `<a class="btn-dl" href="${pdfUrl(guide)}" rel="noopener"><span class="ico">${docIco}</span><span><span class="t">${t(lang!, "guide")}</span><br><span class="m">PDF${ver(guide)}</span></span>${arr}</a>` : "",
        pdfUrl(htp) ? `<a class="btn-dl" href="${pdfUrl(htp)}" rel="noopener"><span class="ico">${docIco}</span><span><span class="t">${t(lang!, "how_to_play")}</span><br><span class="m">PDF${ver(htp)}</span></span>${arr}</a>` : "",
      ].join("")}
    />
  </section>

  <article class="wrap-read" style="padding-block:var(--sp-8) var(--sp-11)">
    {html ? <div class="prose-tale" set:html={html} /> : <p class="muted">Coming soon.</p>}
  </article>
</Base>
