---
import Base from "../../layouts/Base.astro";
import { LANGS, localeOf } from "../../consts";
import { site, pdfUrl, pdfVer, narrationHtml } from "../../lib/content";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((l) => ({ params: { lang: l.code } }));
}
const { lang } = Astro.params;
const locale = localeOf(lang!);
const html = narrationHtml(`guide/${locale}/guide.md`); // strips the guide's own H1
const htp = site.shared_pdfs?.[locale]?.how_to_play;
const guide = site.shared_pdfs?.[locale]?.guide;
const ver = (e: any) => (pdfVer(e) ? ` (${pdfVer(e)})` : "");
---

<Base lang={lang!} route="help" title={`${t(lang!, "nav_help")} · Wander & Tales`} description={t(lang!, "meta_help")}>
  <section class="bg-gradient-to-b from-teal/15 to-transparent">
    <div class="max-w-3xl mx-auto px-4 pt-12 pb-6">
      <h1 class="font-display text-3xl md:text-4xl text-pine">{t(lang!, "nav_help")}</h1>
      <p class="mt-3 text-ink/75">{t(lang!, "hero_sub")}</p>
      <div class="mt-5 flex flex-wrap gap-2 text-sm">
        {pdfUrl(htp) && <a href={pdfUrl(htp)} class="bg-teal text-white px-4 py-2 rounded-full hover:brightness-105" rel="noopener">{t(lang!, "how_to_play")} (PDF){ver(htp)}</a>}
        {pdfUrl(guide) && <a href={pdfUrl(guide)} class="ring-1 ring-ink/20 px-4 py-2 rounded-full hover:bg-white" rel="noopener">{t(lang!, "guide")} (PDF){ver(guide)}</a>}
      </div>
    </div>
  </section>

  <article class="max-w-3xl mx-auto px-4 pb-16">
    {html ? <div class="prose-tale" set:html={html} /> : <p class="text-ink/60">Coming soon.</p>}
  </article>
</Base>
