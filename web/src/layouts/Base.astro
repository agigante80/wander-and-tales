---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LANGS, SITE_URL, CF_ANALYTICS_TOKEN, localeOf } from "../consts";
import { site } from "../lib/content";
import { t } from "../lib/i18n";

interface Props {
  lang: string;
  route?: string;
  title: string;
  description?: string;
  image?: string;
  jsonld?: unknown;
}
const { lang, route = "", title, description, image, jsonld } = Astro.props;
const locale = localeOf(lang);
const desc = description ?? site.tagline[locale];
const path = route ? `/${lang}/${route}` : `/${lang}/`;
const canonical = SITE_URL + path;
const ogImage = image ? SITE_URL + image : SITE_URL + "/og-image.png";
const alt = (code: string) => `${SITE_URL}/${code}${route ? "/" + route : "/"}`;
const ogLocale = locale.replace("-", "_");
const ogLocaleAlt = LANGS.filter((l) => l.locale !== locale).map((l) => l.locale.replace("-", "_"));
// every page gets structured data; pages may override with their own jsonld
const ld = jsonld ?? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description: desc,
  url: canonical,
  inLanguage: locale,
  isPartOf: { "@type": "WebSite", name: "Wander & Tales", url: SITE_URL + "/" },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l.locale} href={alt(l.code)} />)}
    <link rel="alternate" hreflang="x-default" href={alt("en")} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#5b62a8" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wander & Tales" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlt.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {
      CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-3 focus:bg-cream">{t(lang, "skip")}</a>
    <Header lang={lang} route={route} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
