---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { LANGS, SITE_URL, CF_ANALYTICS_TOKEN, localeOf } from "../consts";
import { site } from "../lib/content";
import { t } from "../lib/i18n";

interface Props {
  lang: string;
  route?: string;
  title: string;
  description?: string;
  image?: string;
  jsonld?: unknown;
}
const { lang, route = "", title, description, image, jsonld } = Astro.props;
const locale = localeOf(lang);
const desc = description ?? site.tagline[locale];
// trailing slash on every path, matching the directory build and the sitemap
const path = `/${lang}/${route ? route + "/" : ""}`;
const canonical = SITE_URL + path;
const ogImage = image ? SITE_URL + image : SITE_URL + "/og-image.png";
const alt = (code: string) => `${SITE_URL}/${code}/${route ? route + "/" : ""}`;
const ogLocale = locale.replace("-", "_");
const ogLocaleAlt = LANGS.filter((l) => l.locale !== locale).map((l) => l.locale.replace("-", "_"));
// every page gets structured data; pages may override with their own jsonld
const ld = jsonld ?? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description: desc,
  url: canonical,
  inLanguage: locale,
  isPartOf: { "@type": "WebSite", name: "Wander & Tales", url: SITE_URL + "/" },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("wt-theme");
          if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l.locale} href={alt(l.code)} />)}
    <link rel="alternate" hreflang="x-default" href={alt("en")} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#5b62a8" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wander & Tales" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlt.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {
      CF_ANALYTICS_TOKEN && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body>
    <a href="#main" class="skip">{t(lang, "skip")}</a>
    <Header lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      (function () {
        "use strict";
        var root = document.documentElement;
        function cur() {
          return root.getAttribute("data-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        }
        function setTheme(t, persist) {
          root.setAttribute("data-theme", t);
          if (persist) { try { localStorage.setItem("wt-theme", t); } catch (e) {} }
          document.querySelectorAll("[data-theme-toggle]").forEach(function (b) {
            b.setAttribute("aria-pressed", String(t === "dark"));
          });
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute("content", t === "dark" ? "#1a1c26" : "#5b62a8");
        }
        document.addEventListener("click", function (e) {
          var t = e.target.closest("[data-theme-toggle]");
          if (t) setTheme(cur() === "dark" ? "light" : "dark", true);
        });
        try {
          matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function (ev) {
            if (!localStorage.getItem("wt-theme")) setTheme(ev.matches ? "dark" : "light", false);
          });
        } catch (e) {}
        setTheme(cur(), false);

        var saved; try { saved = localStorage.getItem("wt-level"); } catch (e) {}
        document.querySelectorAll("[data-reader]").forEach(function (reader) {
          if (saved) reader.setAttribute("data-level", saved);
          var seg = reader.querySelector("[data-level-seg]") || document.querySelector("[data-level-seg]");
          if (!seg) return;
          function paint() {
            var lvl = reader.getAttribute("data-level");
            seg.querySelectorAll("button").forEach(function (b) {
              b.setAttribute("aria-pressed", String(b.dataset.level === lvl));
            });
          }
          seg.addEventListener("click", function (e) {
            var b = e.target.closest("button[data-level]");
            if (!b) return;
            reader.setAttribute("data-level", b.dataset.level);
            try { localStorage.setItem("wt-level", b.dataset.level); } catch (err) {}
            paint();
          });
          paint();
        });

        var mb = document.querySelector("[data-menu-toggle]");
        var mn = document.querySelector("[data-mobile-nav]");
        if (mb && mn) {
          mb.addEventListener("click", function () {
            var o = mn.classList.toggle("open");
            mb.setAttribute("aria-expanded", String(o));
          });
        }

        document.querySelectorAll("[data-lang]").forEach(function (g) {
          var btn = g.querySelector("[data-lang-btn]");
          var menu = g.querySelector("[data-lang-menu]");
          if (!btn || !menu) return;
          btn.addEventListener("click", function (e) {
            e.stopPropagation();
            var o = menu.classList.toggle("open");
            btn.setAttribute("aria-expanded", String(o));
          });
        });
        document.addEventListener("click", function () {
          document.querySelectorAll("[data-lang-menu].open").forEach(function (m) {
            m.classList.remove("open");
            var b = m.parentElement.querySelector("[data-lang-btn]");
            if (b) b.setAttribute("aria-expanded", "false");
          });
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") document.querySelectorAll(".open").forEach(function (m) { m.classList.remove("open"); });
        });
      })();
    </script>
  </body>
</html>
