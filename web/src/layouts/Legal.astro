---
import Base from "./Base.astro";
const { lang, route, heading, description, image } = Astro.props;
---

<Base lang={lang} route={route} title={`${heading} · Wander & Tales`} description={description} image={image}>
  <article class="wrap-read" style="padding-block:var(--sp-9) var(--sp-11)">
    <h1 style="font-size:var(--fs-h2);color:var(--pine)">{heading}</h1>
    <div class="prose-tale" style="margin-top:var(--sp-4)"><slot /></div>
  </article>
</Base>
