# Template for local secrets. Copy this file to .env and fill in the values.
# .env is gitignored; this .env.example is committed as documentation.
#
#   cp .env.example .env
#   # then paste your key after OPENAI_API_KEY=
#
# Used by `python -m build generate-images` to create kit art via the OpenAI
# Images API. Get a key at https://platform.openai.com/api-keys

OPENAI_API_KEY=
