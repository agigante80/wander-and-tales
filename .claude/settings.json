{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dashes.sh\"",
            "statusMessage": "Checking for em and en dashes",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit.sh\"",
            "statusMessage": "Auto-committing and pushing changes",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
