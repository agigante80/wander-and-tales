# Build output (PDFs are generated from content; do not track build artifacts)
dist/

# Local scratch / temporary files (zips to inspect, throwaway experiments).
temp/

# Downloaded third-party sample files studied in the landscape research.
# We study them locally but never redistribute others' content; keep only the README.
research/landscape/samples/*
!research/landscape/samples/README.md

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Local-only Claude Code overrides (team settings live in .claude/settings.json)
.claude/settings.local.json

# Local secrets (API keys etc.). Never commit. See .env.example for the template.
.env

# Packaging metadata
*.egg-info/
.eggs/

.playwright-mcp/

# Private journal (local thinking notes, never committed)
.private-journal/
# --- AI assistant files (local only, never published) ---
# Anchored entries (/NAME) are root-only on purpose: a nested AGENTS.md or
# CLAUDE.md can belong to the project's own content and must stay tracked.
.claude/
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md
/GEMINI.md
.gemini/
.codex/
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.windsurf/
.windsurfrules
.clinerules
.roo/
.roomodes
.devin/
.specstory/
.github/copilot-instructions.md
