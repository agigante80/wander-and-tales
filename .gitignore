# Build output (PDFs are generated from content; do not track build artifacts)
dist/

# Local scratch / temporary files (zips to inspect, throwaway experiments).
temp/

# Downloaded third-party sample files studied in the landscape research.
# We study them locally but never redistribute others' content; keep only the README.
research/landscape/samples/*
!research/landscape/samples/README.md

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Local-only Claude Code overrides (team settings live in .claude/settings.json)
.claude/settings.local.json

# Local secrets (API keys etc.). Never commit. See .env.example for the template.
.env

# Packaging metadata
*.egg-info/
.eggs/

.playwright-mcp/

# Private journal (local thinking notes, never committed)
.private-journal/
# --- AI assistant files (local only, never published) ---
# Anchored entries (/NAME) are root-only on purpose: a nested AGENTS.md or
# CLAUDE.md can belong to the project's own content and must stay tracked.
.claude/
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md
/GEMINI.md
.gemini/
.codex/
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.windsurf/
.windsurfrules
.clinerules
.roo/
.roomodes
.devin/
.specstory/
.github/copilot-instructions.md
# --- leak-guard baseline: do not edit between the markers ---
# Assistant state directories, matched at any depth.
.antigravity/
.codeium/
.cline/
.sourcegraph/
.cody/
.tabnine/
.amazonq/
.junie/
.qodo/
.openhands/
.goose/
.kilocode/
.augment/
.trae/
.bolt/
.opencode/
.crush/
.factory/
.amp/
.codebuff/
.agent-os/
.taskmaster/
.copilot/
# Instruction and config files, ROOT-ANCHORED: a nested AGENTS.md or CLAUDE.md can be
# the project's own content (tuya-local ships one under custom_components/).
/AGENT.md
/.cursorrules
/.cursorignore
/.cursorindexingignore
/.windsurfrules
/.clinerules
/.roomodes
/.rooignore
/.aider.conf.yml
/.aiderignore
/.augmentignore
/.gptignore
/.llmignore
/.airules
/.mcp.json
/.github/copilot-instructions.md
# Chat transcripts — the highest-value leak in the category.
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*/
repomix-output.*
# Coverage and test caches: an absolute path in every record.
.coverage
.coverage.*
coverage.xml
htmlcov/
lcov.info
.tox/
.nox/
# Type and lint caches.
.ruff_cache/
# Build output: embeds the build root.
build/
*.sarif
# Environments: absolute paths in every script shebang.
env/
node_modules/
*.py[cod]
# Secrets. The negations are mandatory: six repos track a .env.example on purpose.
.env.*
!.env.example
!.env.template
*.pem
*.key
# Editor and OS. koel tracks a .vscode/mcp.json — editor dirs are becoming assistant dirs.
.vscode/
.idea/
.zed/
*.swo
# --- end leak-guard baseline ---
# build/ is this project's Python package (pyproject.toml packages = ["build", ...]),
# not build output; the leak-guard baseline above ignores build/ and this negates it.
!build/
